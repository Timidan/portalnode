# Copy to .env and fill in. Never commit .env or secrets/.
NODE_NAME=portalnode
# Mainnet genesis; the agent refuses to sign if the chain doesn't match.
PORTALDOT_GENESIS=0x83b5212c69f85f3996f8696bb35bf913af51b176a5f53d0a74fd3a83dc0b8a54
# Bearer token for the console's write actions (generate: openssl rand -hex 32).
PORTALNODE_TOKEN=
# Validator stashes the keeper may pay out for (comma-separated). Empty = keeper only plans.
PORTALNODE_ALLOWLIST=
# Keeper key: a small, separate account (never your stash). Put its subkey JSON in secrets/keeper.json.
PORTALNODE_KEEPER_FILE=/run/secrets/keeper.json
